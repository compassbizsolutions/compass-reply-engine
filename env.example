# Copy to .env and fill in. Never commit the real .env file.

# Supabase (Settings → API in your Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Business Profile OAuth app (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Trustpilot Service Reviews API (business.trustpilot.com → API registration)
# API key reads reviews; client id/secret are used to refresh a connected business's
# reply-posting OAuth token (see src/trustpilot.js).
TRUSTPILOT_API_KEY=your-trustpilot-api-key
TRUSTPILOT_CLIENT_ID=your-trustpilot-oauth-client-id
TRUSTPILOT_CLIENT_SECRET=your-trustpilot-oauth-client-secret

# Facebook Graph API app (developers.facebook.com) — used to obtain each connected business's
# long-lived Page access token (fetch-only; there is no reply-posting endpoint, see src/facebook.js)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
